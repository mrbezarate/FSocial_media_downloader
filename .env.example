# ═══════════════════════════════════════════════════════════════════════════════
# FSocial Media Downloader — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Required ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELOXIDE_TOKEN="YOUR_BOT_TOKEN_HERE"

# Get from https://my.telegram.org/apps (required for Local Bot API Server)
TELEGRAM_API_ID="your_api_id"
TELEGRAM_API_HASH="your_api_hash"

# Telegram User ID of the admin (for /admin commands)
ADMIN_ID=""

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD="fsocial_secret"

# ─── Spotify Integration (optional) ──────────────────────────────────────
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ─── Proxy Pool (optional, comma-separated) ──────────────────────────────
# Example: socks5://user:pass@proxy1:1080,socks5://user:pass@proxy2:1080
PROXY_LIST=""

# ─── yt-dlp Cookies (optional, for premium YouTube Music) ────────────────
# Path to cookies.txt exported from browser
COOKIES_PATH=""

# ─── Worker Tuning ───────────────────────────────────────────────────────
MAX_CONCURRENT_DOWNLOADS=10

# ─── Logging ─────────────────────────────────────────────────────────────
# Options: trace, debug, info, warn, error
RUST_LOG=info
