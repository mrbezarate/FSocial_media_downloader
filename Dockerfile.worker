# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM rust:slim-bookworm AS builder

WORKDIR /app

# System dependencies for building (including lofty audio tag support)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Cache dependencies: copy manifests first
COPY Cargo.toml Cargo.toml
COPY common/Cargo.toml common/Cargo.toml
COPY worker/Cargo.toml worker/Cargo.toml

# Create dummy workspace member dirs
RUN mkdir -p common/src && echo "pub fn dummy() {}" > common/src/lib.rs
RUN mkdir -p worker/src && echo "fn main() {}" > worker/src/main.rs
# Gateway is a workspace member but we don't need to build it here
RUN mkdir -p gateway/src && echo "fn main() {}" > gateway/src/main.rs
COPY gateway/Cargo.toml gateway/Cargo.toml

# Build only dependencies (cached layer)
RUN cargo build --release --package fsocial-worker 2>/dev/null || true
RUN rm -rf common/src worker/src

# Copy real source code
COPY common/ common/
COPY worker/ worker/

# Touch main.rs to force rebuild
RUN touch common/src/lib.rs worker/src/main.rs
RUN cargo build --release --package fsocial-worker

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

WORKDIR /app

# Runtime dependencies: ffmpeg for media processing, python3 for yt-dlp, SSL certs
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    ffmpeg \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    python3-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install yt-dlp via pip to include curl-cffi for impersonation bypass (e.g. TikTok)
RUN pip3 install --no-cache-dir --break-system-packages "yt-dlp[default,curl-cffi]"

# Create directories
RUN mkdir -p /shared_data /app/cache

# Copy compiled binary
COPY --from=builder /app/target/release/fsocial-worker /app/worker

# Run as non-root user
RUN useradd -m workeruser && chown -R workeruser:workeruser /app /shared_data
USER workeruser

ENV RUST_LOG=info
ENV YTDLP_PATH=/usr/local/bin/yt-dlp
ENV FFMPEG_PATH=/usr/bin/ffmpeg

CMD ["/app/worker"]
