# ─── Stage 1: Planner ────────────────────────────────────────────────────────
FROM lukemathwalker/cargo-chef:latest-rust-1 AS chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ─── Stage 2: Cacher & Builder ───────────────────────────────────────────────
FROM chef AS builder
# System dependencies for building (including lofty audio tag support)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=planner /app/recipe.json recipe.json
# Build dependencies - this is the caching Docker layer!
RUN cargo chef cook --release --recipe-path recipe.json

# Build application
COPY . .
RUN cargo build --release --package fsocial-worker

# ─── Stage 3: Runtime ────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime
WORKDIR /app

# Runtime dependencies: ffmpeg for media processing, python3 for yt-dlp, SSL certs, libpq
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    ffmpeg \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    python3-dev \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install yt-dlp via pip to include curl-cffi for impersonation bypass (e.g. TikTok)
# Cache bust: 2026-07-23 (yt-dlp update to nightly)
RUN pip3 install -U --no-cache-dir --break-system-packages "https://github.com/yt-dlp/yt-dlp/archive/master.tar.gz" "curl-cffi"

# Create directories
RUN mkdir -p /shared_data /app/cache

# Copy compiled binary
COPY --from=builder /app/target/release/fsocial-worker /app/worker

# Run as non-root user
RUN useradd -m workeruser && chown -R workeruser:workeruser /app /shared_data
USER workeruser

ENV RUST_LOG=info
ENV YTDLP_PATH=/usr/local/bin/yt-dlp
ENV FFMPEG_PATH=/usr/bin/ffmpeg

CMD ["/app/worker"]
